node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Native build output (created by prebuild/EAS local builds)
android/
ios/

# Environment files — contain real project keys
.env
.env.local
.env.*.local

# EAS-downloaded signing credentials — the keystore itself falls under the
# android/ ignore above, but credentials.json (passwords, key alias) does
# not and must never be committed in plain text.
credentials.json
credentials/
*.jks

# Web export used for manual Vercel redeploys — a fresh dist_newN/ dir gets
# created each time the previous one is still locked by a leftover process
dist_new*/

# Editor/OS
.vscode/
.DS_Store
*.orig.*
